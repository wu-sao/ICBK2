#include <iostream>
#include <vector>
using namespace std;

class MyClass
{
public:
    void fun(vector<int>& arr)
    {
        int minPos = 0;
        for (int i = 0; i < arr.size(); i++)
        {
            if (arr[i] < arr[minPos])
            {
                minPos = i;
            }
        }
        swap(arr[minPos], arr.back());
    }
};

void printArr(const vector<int>& v)
{
    for (int i = 0; i < v.size(); i++)
    {
        if (i != 0)
            cout << ", ";
        cout << v[i];
    }
}

int main()
{
    int n;
    cin >> n;
    vector<int> a(n);
    for (int i = 0; i < n; i++)
    {
        cin >> a[i];
    }

    MyClass obj;
    obj.fun(a);

    printArr(a);

    return 0;
}
